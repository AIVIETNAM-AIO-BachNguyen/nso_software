# Server-only settings. Never use NEXT_PUBLIC_ for research credentials.
# Storage: a durable SQLite disk or PostgreSQL; tests cover both, including restore.
# NSO_DATABASE_URL=sqlite:////absolute/path/to/research.db
NSO_V3_NPM_ENABLED=false
NSO_V3_IPM_RESEARCH_ENABLED=false
NSO_V3_OPTIMIZER_ENABLED=false
NSO_V3_MANUFACTURING_ENABLED=false
# Shadow-only V3.1; this switch cannot enable clinical adaptive prescribing.
NSO_V3_ADAPTIVE_RANKING_ENABLED=false
# Provision individual sessions with unique actor, SHA-256 token digest, server-owned
# roles and an explicit patient list. No wildcard patients and no client-selected role.
NSO_V3_PRINCIPALS=[]
# Example structure only; do not use this placeholder digest as a credential:
# [{"actor":"study-user-1","token_sha256":"<64 hex characters>","roles":["researcher"],"patient_ids":["approved-study-id"],"expires_at":"<UTC ISO timestamp>"}]
# Production requires expiration. Use distinct actors for authors, reviewers and deployers.
# Roles: researcher, optical_engineer, manufacturing_engineer, adaptive_researcher,
# validator, design_approver, deployer, admin.
# Never use real patient data in the synthetic local staging launcher.
# Optional standalone deployment: uvicorn research_app:app
NSO_V3_SERVICE=all
